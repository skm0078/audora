<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark build only (never shipped): lets the shell read this build's profile, which :baselineprofile records
     (ADR 2026-10-30-baseline-profile). Release and dev stay unprofileable. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true" />
    </application>
</manifest>
