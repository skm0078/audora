<?xml version="1.0" encoding="utf-8"?>
<!-- File: app/src/main/res/mipmap-anydpi/ic_launcher.xml -->
<!-- Purpose: The launcher icon (ADR-065): the hand-drawn ListenLock logo on white, inside the 66dp safe zone so
     circle and squircle masks never cut it; its ink alone is the themed (monochrome) icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_logo" />
    <monochrome android:drawable="@drawable/ic_launcher_logo_monochrome" />
</adaptive-icon>
