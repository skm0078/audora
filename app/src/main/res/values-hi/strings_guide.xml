<resources>
    <string name="library_character_guide">पात्रों की सूची</string>
    <string name="guide_title">कौन कौन है: %1$s</string>
    <string name="guide_empty">आप जहाँ तक पहुँचे हैं, वहाँ तक अभी कोई पात्र नहीं। हर व्यक्ति से मिलते ही उसे जोड़ें; वह उसी पेज से दिखेगा जहाँ आप उससे मिले, इसलिए सूची कभी आगे आने वालों का राज़ नहीं खोलती।</string>
    <plurals name="guide_later">
        <item quantity="one">किताब में आगे 1 और (वहाँ पहुँचने तक छिपा)</item>
        <item quantity="other">किताब में आगे %d और (वहाँ पहुँचने तक छिपे)</item>
    </plurals>
    <string name="guide_met_on">पेज %1$d पर मिले</string>
    <string name="guide_add">पात्र जोड़ें</string>
    <string name="guide_edit">पात्र बदलें</string>
    <string name="guide_name">नाम</string>
    <string name="guide_note">वे कौन हैं (चाहें तो)</string>
    <string name="guide_page">किस पेज पर मिले</string>
    <string name="guide_delete">हटाएँ</string>
    <string name="guide_save">सेव करें</string>
    <string name="guide_cancel">रद्द करें</string>
    <string name="guide_close">बंद करें</string>
    <string name="guide_deleted">पात्र हटाया गया।</string>
    <string name="guide_undo">वापस लाएँ</string>
    <string name="guide_full">यह सूची भर गई है: एक किताब में ज़्यादा से ज़्यादा %1$d पात्र रह सकते हैं। नया जोड़ने के लिए कोई एक हटाएँ।</string>
