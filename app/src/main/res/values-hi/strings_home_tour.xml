    <string name="tour_listen_title">सुनने के लिए किताब पर टैप करें</string>
    <string name="tour_listen_body">यह वहीं से खुलती है जहाँ आप रुके थे। चलाएँ दबाएँ, और प्लेयर हर टैब पर नीचे बना रहता है।</string>
    <string name="tour_menu_title">किताब को दबाकर रखें</string>
    <string name="tour_menu_body">उस किताब का सब कुछ यहाँ है: आगे चलाएँ, शेयर करें, ऑडियोबुक के रूप में सहेजें, पूरी हुई चिह्नित करें।</string>
    <string name="tour_notes_title">आपके नोट्स</string>
    <string name="tour_notes_body">हर किताब के बुकमार्क, हाइलाइट और आवाज़ वाले नोट, एक ही जगह।</string>
    <string name="tour_made_title">आपकी रचनाएँ</string>
    <string name="tour_made_body">आपकी बनाई ऑडियोबुक, कोट कार्ड और वीडियो यहाँ आते हैं, उनकी प्रगति के साथ।</string>
    <string name="tour_you_title">इसे अपना बनाएँ</string>
    <string name="tour_you_body">आवाज़ें, रूप, भाषा, निजता और मदद आप में हैं। लाइब्रेरी की खोज सेटिंग भी ढूँढती है।</string>
    <string name="settings_tour_title">मुझे दिखाएँ</string>
