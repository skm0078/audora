<?xml version="1.0" encoding="utf-8"?>
<!--
  File: app/src/main/res/xml/widget_resume_info.xml
  Purpose: The Resume widget's size and preview (plan item 35). updatePeriodMillis 0: the app redraws it when the
  latest book or its progress changes, so it never wakes the phone on a timer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_resume"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:previewLayout="@layout/widget_resume"
    android:resizeMode="horizontal"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
