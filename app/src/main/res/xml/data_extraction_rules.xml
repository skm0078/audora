<?xml version="1.0" encoding="utf-8"?>
<!--
  File: app/src/main/res/xml/data_extraction_rules.xml
  Purpose: Nothing of the app's data goes to Google's cloud backup or to a new phone through Android's device transfer
  (ADR-061). allowBackup="false" stops only the cloud backup on Android 12+; device transfer needs these rules.
  Moving to a new phone is the app's own Back up and restore (ADR-046), a file the person saves themselves.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
