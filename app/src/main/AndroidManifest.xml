<?xml version="1.0" encoding="utf-8"?>
<!--
  File: app/src/main/AndroidManifest.xml
  Purpose: App entry points. Permissions arrive with the tickets that need them
  (FGS media playback in S3/P1-04, notifications on first play). Never SMS, accessibility
  or notification-listener permissions (AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Asked on the first play (P1-05) so the media notification and lock-screen controls show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery onboarding (P1-06): the system "always run in background" prompt. Reading stops with the screen
         off on several brands without it (Build Spec §6). -->

    <!-- Voice notes (plan item 32, ADR-041): asked the first time the listener records one, never otherwise. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Point and read (item 62) uses the camera app, which needs no permission; a declared but ungranted CAMERA
         permission (merged from a library) would make that intent throw, so none may be merged in. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <!-- The optional app lock (ADR-061) asks through Android's own fingerprint, face or screen-lock prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- No camera needed: the camera app takes the photo, and phones without one never see Point and read fail. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".AudoraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Audora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" and "Share to" for books from Files, Downloads, WhatsApp or mail: PDFs (ADR-033), EPUB and
                 text (ADR-042), Word, OpenDocument, RTF, HTML, Markdown and pictures (ADR-066); text shared from a
                 browser or chat. Every file is checked by its first bytes, so a mislabelled one is refused, not read. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
            </intent-filter>
            <!-- Several pictures shared at once (the pages of a chapter) become one book (ADR-066). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
            </intent-filter>
            <!-- "Read aloud" in any app's text-selection menu (ADR-066). -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The Resume widget (plan item 35): draws what the app saved; Resume opens MainActivity. -->
        <receiver
            android:name=".widget.ResumeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_resume_info" />
        </receiver>

        <!-- Quick Settings tile (plan item 36): play or pause through the media session, or resume the last book. -->
        <service
            android:name=".tile.PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_play"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Hands the Share logs zip (cacheDir/shared-logs only) to the app the user picks (P1-07). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_share_paths" />
        </provider>
    </application>
</manifest>
