<?xml version="1.0" encoding="utf-8"?>
<!--
  File: app/src/main/AndroidManifest.xml
  Purpose: App entry points. Permissions arrive with the tickets that need them
  (FGS media playback in S3/P1-04, notifications on first play). Never SMS, accessibility
  or notification-listener permissions (AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked on the first play (P1-05) so the media notification and lock-screen controls show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery onboarding (P1-06): the system "always run in background" prompt. Reading stops with the screen
         off on several brands without it (Build Spec §6). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AudoraApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Audora">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with Audora" and "Share to Audora" for PDFs from Files, Downloads, WhatsApp or mail (ADR-033). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- The Resume widget (plan item 35): draws what the app saved; Resume opens MainActivity. -->
        <receiver
            android:name=".widget.ResumeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_resume_info" />
        </receiver>

        <!-- Hands the Share logs zip (cacheDir/shared-logs only) to the app the user picks (P1-07). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_share_paths" />
        </provider>
    </application>
</manifest>
