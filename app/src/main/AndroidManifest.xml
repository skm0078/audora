<?xml version="1.0" encoding="utf-8"?>
<!--
  File: app/src/main/AndroidManifest.xml
  Purpose: App entry points. Permissions arrive with the tickets that need them
  (FGS media playback in S3/P1-04, notifications on first play). Never SMS, accessibility
  or notification-listener permissions (AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".AudoraApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Audora">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
