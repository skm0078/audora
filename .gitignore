# Gradle / Android build output
.gradle/
build/
local.properties
.kotlin/
captures/
*.apk
*.aab
*.ap_
*.dex

# IDEs
.idea/
*.iml
.vscode/
.DS_Store

# Never commit signing material or secrets (AGENTS.md)
*.jks
*.keystore
*.p12
keystore.properties
signing/

# Large binaries live outside git (models download at runtime; PDFs may not be redistributable)
*.onnx
models/
*.pdf
!testdata/pdfs/**/*.pdf
# Small redistributable fixtures for :pdf's instrumented tests (licences in that folder's SOURCES.md)
!pdf/src/androidTest/assets/pdfs/*.pdf
# The same kind of fixture for :playback's instrumented tests (P3-01)
!playback/src/androidTest/assets/pdfs/*.pdf
# And for the app's release journey test (copies of two :pdf fixtures)
!app/src/androidTest/assets/pdfs/*.pdf
# The golden corpus (P2-01): redistributable excerpts only, licences in pdf/golden/README.md
!pdf/golden/pdfs/*.pdf
# The listening corpus (RI-8a): redistributable excerpts only, licences in pdf/golden/listening/README.md
!pdf/golden/listening/pdfs/*.pdf

# Python
__pycache__/
*.pyc
pdf/src/androidTest/assets/ocr/

# Local preview of the site (docs/CONTENT.md)
docs/Gemfile
docs/Gemfile.lock
docs/_site/
docs/.jekyll-cache/
