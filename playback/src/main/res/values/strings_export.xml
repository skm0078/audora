<?xml version="1.0" encoding="utf-8"?>
<!--
  File: playback/src/main/res/values/strings_export.xml
  Purpose: Clip, accessible copy, talking-book, audiobook resume and cast strings (plan items 41, 63, 69, 76, ADR-040, ADR-034).
-->
<resources>
    <!-- Audiobook export with "A voice for each character" on (plan item 63): an English narrator with one speaker. -->
    <string name="export_cast_needs_built_in_voice">Characters are read in one voice: character voices need a built-in Kokoro or Kitten English voice.</string>
    <!-- The same for a book that also reads Hindi or Bengali, while its English characters get voices. -->
    <string name="export_cast_english_only">Character voices work for English only, so Hindi and Bengali characters share one voice.</string>
    <!-- Share as audio (plan item 41). -->
    <string name="clip_channel">Audio clips</string>
    <string name="clip_making">Making the audio clip…</string>
    <string name="clip_ready">Audio clip ready</string>
    <string name="clip_share">Share</string>
    <string name="clip_chooser_title">Share the audio clip</string>
    <string name="clip_failed_text">Could not make the audio clip from this sentence</string>
    <!-- File name of a clip: %1$s the book's title, %2$d the page, e.g. "Moby Dick - page 12". -->
    <string name="clip_file_name">%1$s - page %2$d</string>
    <!-- Text sent with the clip: %1$s the passage, %2$s the title, %3$d the page. -->
    <string name="clip_share_text">“%1$s” (%2$s, page %3$d)</string>
    <!-- Accessible copy and talking book (plan items 69 and 76, ADR-040). -->
    <string name="copy_channel">Accessible copies</string>
    <string name="copy_preparing">Preparing the copy…</string>
    <!-- %1$s is the book's title. -->
    <string name="copy_running">Accessible copy: “%1$s”</string>
    <string name="copy_talking_running">Talking book: “%1$s”</string>
    <string name="copy_step_reading">Reading the pages (scanned pages take longer)</string>
    <string name="copy_step_voicing">Reading the book aloud into the file</string>
    <string name="copy_cancel">Cancel</string>
    <string name="copy_busy">Another copy is being made; cancel it from its notification first</string>
    <string name="copy_done_title">Saved: “%1$s”</string>
    <!-- %1$s the file names, %2$s the folder, e.g. "Book.epub and Book.txt in Documents/Audora". -->
    <string name="copy_done_text">%1$s in %2$s</string>
    <string name="copy_name_separator">" and "</string>
    <!-- %1$d is a number of pages. -->
    <string name="copy_skipped">Pages without readable text: %1$d.</string>
    <string name="copy_failed_title">Copy not saved</string>
    <string name="copy_failed_empty">No page of this PDF has readable text, even with text recognition</string>
    <string name="copy_failed_unreadable">The PDF could not be read from page %1$d</string>
    <string name="copy_failed_storage">Could not save the file: %1$s</string>
    <string name="copy_cancelled_title">Copy cancelled</string>
    <string name="copy_cancelled_text">Nothing was saved</string>
    <string name="copy_timed_out_title">Copy paused by Android\'s time limit</string>
    <string name="copy_timed_out_text">Android stops long jobs after 6 hours. Tap Continue to open Audora and go on; a talking book keeps its finished chapters and renders only the rest.</string>
    <string name="copy_continue">Continue</string>
    <!-- File name of a talking book: %1$s the title, e.g. "Moby Dick - talking book". -->
    <string name="copy_talking_book_file">%1$s - talking book</string>
    <!-- Title of a chapter with no heading: %1$d and %2$d are pages. -->
    <string name="copy_pages">Pages %1$d–%2$d</string>
    <!-- Words inside the copy itself. -->
    <string name="copy_contents">Contents</string>
    <string name="copy_page_list">Pages</string>
    <string name="copy_notes">Notes</string>
    <string name="copy_summary_text">Text from the book with its headings, lists, tables, notes and page numbers (the PDF\'s page positions, which may differ from the numbers printed on its pages). Scanned pages were read with text recognition and may contain recognition errors.</string>
    <string name="copy_summary_audio">Text from the book with its headings, lists, tables, notes and page numbers (the PDF\'s page positions, which may differ from the numbers printed on its pages), narrated by a synthetic voice with each sentence highlighted as it is read. Scanned pages were read with text recognition and may contain recognition errors.</string>
    <!-- Highlights and notes export (plan item 30). %1$s is the book's title. -->
    <string name="notes_file">%1$s - notes</string>
    <string name="notes_highlights">Highlights</string>
    <string name="notes_bookmarks">Bookmarks</string>
    <string name="notes_voice_notes">Voice notes</string>
    <!-- %d is a page number; keep exactly one %d. -->
    <string name="notes_page" formatted="false">Page %d</string>
    <string name="notes_note">Note</string>
    <!-- Save as audiobook goes on where it stopped (ADR-034). %1$s is the book's title. -->
    <string name="export_timed_out_title">Saving “%1$s” paused by Android\'s time limit</string>
    <string name="export_timed_out_text">Android stops long jobs after 6 hours. Tap Continue to open Audora and go on; chapters already saved are kept.</string>
    <string name="export_continue">Continue</string>
    <!-- %1$s is the folder, e.g. "Audiobooks/Moby Dick". -->
    <string name="export_cancelled_resume">Chapters already saved are kept in %1$s. Save the book as an audiobook again to go on from there.</string>
    <string name="long_job_restoring">A backup is being restored, so this can\'t start now. Try again after the app restarts.</string>
</resources>
