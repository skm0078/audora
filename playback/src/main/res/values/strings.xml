<?xml version="1.0" encoding="utf-8"?>
<!-- File: playback/src/main/res/values/strings.xml
     Purpose: Notification and lock-screen text for the playback service. -->
<resources>
    <!-- Shown under the book title, e.g. "Page 3 of 50". -->
    <string name="playback_page_of">Page %1$d of %2$d</string>
    <!-- Shown while the next page is still being prepared. -->
    <string name="playback_loading_next_page">Preparing the next page…</string>

    <!-- Audiobook export (ADR-034): the notification channel and its notifications. -->
    <string name="export_channel">Audiobook export</string>
    <string name="export_channel_description">Progress while a book is saved as audio files</string>
    <!-- %1$s is the book's title. -->
    <string name="export_running_title">Saving “%1$s” as an audiobook</string>
    <!-- e.g. "Chapter 3 of 12 · 41%". -->
    <string name="export_running_text">Chapter %1$d of %2$d · %3$d%%</string>
    <string name="export_preparing">Preparing…</string>
    <string name="export_cancel">Cancel</string>
    <string name="export_done_title">Audiobook ready: “%1$s”</string>
    <!-- %1$d files, %2$s a duration like "2 h 05 min", %3$s the folder, e.g. "Audiobooks/Moby Dick". -->
    <plurals name="export_done_text">
        <item quantity="one">%1$d file, %2$s, in %3$s</item>
        <item quantity="other">%1$d files, %2$s, in %3$s</item>
    </plurals>
    <string name="export_duration">%1$d h %2$02d min</string>
    <string name="export_failed_title">Could not save “%1$s” as an audiobook</string>
    <string name="export_cancelled_title">Stopped saving “%1$s”</string>
    <string name="export_cancelled_text">Chapters already saved are kept in %1$s</string>
    <string name="export_busy">Another book is being saved as an audiobook; try again when it finishes</string>
    <string name="export_untitled">Audiobook</string>
    <!-- Studio mode (plan item 6, ADR-039): renders a book ahead while the phone charges. -->
    <string name="studio_channel">Studio mode</string>
    <string name="studio_channel_description">Progress while a book is rendered ahead for listening</string>
    <string name="studio_preparing_title">Studio mode</string>
    <string name="studio_preparing">Preparing…</string>
    <!-- %1$s is the book's title. -->
    <string name="studio_running_title">Studio mode: “%1$s”</string>
    <!-- %1$s and %2$s are durations like "1 h 05 min", e.g. "1 h 05 min of 6 h 00 min ready". -->
    <string name="studio_running_text">%1$s of %2$s ready</string>
    <!-- Appended to the running text while studio mode waits. -->
    <string name="studio_waiting_charger">Waiting for the charger · %1$s</string>
    <string name="studio_waiting_audio">Paused while audio plays · %1$s</string>
    <string name="studio_start_now">Start now</string>
    <string name="studio_stop">Stop</string>
    <string name="studio_done_title">Ready to listen: “%1$s”</string>
    <!-- %1$s a duration like "6 h 00 min". -->
    <string name="studio_done_text">%1$s rendered ahead in studio quality</string>
    <string name="studio_done_end_text">%1$s rendered ahead, to the end of the book</string>
    <string name="studio_failed_title">Studio mode stopped: “%1$s”</string>
    <string name="studio_stopped_title">Studio mode stopped: “%1$s”</string>
    <string name="studio_stopped_text">What is already rendered stays and plays at once</string>
    <string name="studio_busy">Studio mode is already preparing another book; stop it from its notification first</string>
    <string name="studio_untitled">Book</string>
    <!-- Share as audio (plan item 41). -->
    <string name="clip_channel">Audio clips</string>
    <string name="clip_making">Making the audio clip…</string>
    <string name="clip_ready">Audio clip ready</string>
    <string name="clip_share">Share</string>
    <string name="clip_chooser_title">Share the audio clip</string>
    <string name="clip_failed_text">Could not make the audio clip from this sentence</string>
    <!-- File name of a clip: %1$s the book's title, %2$d the page, e.g. "Moby Dick - page 12". -->
    <string name="clip_file_name">%1$s - page %2$d</string>
    <!-- Text sent with the clip: %1$s the passage, %2$s the title, %3$d the page. -->
    <string name="clip_share_text">“%1$s” (%2$s, page %3$d)</string>
    <!-- Accessible copy and talking book (plan items 69 and 76, ADR-040). -->
    <string name="copy_channel">Accessible copies</string>
    <string name="copy_preparing">Preparing the copy…</string>
    <!-- %1$s is the book's title. -->
    <string name="copy_running">Accessible copy: “%1$s”</string>
    <string name="copy_talking_running">Talking book: “%1$s”</string>
    <string name="copy_step_reading">Reading the pages (scanned pages take longer)</string>
    <string name="copy_step_voicing">Reading the book aloud into the file</string>
    <string name="copy_cancel">Cancel</string>
    <string name="copy_busy">Another copy is being made; cancel it from its notification first</string>
    <string name="copy_done_title">Saved: “%1$s”</string>
    <!-- %1$s the file names, %2$s the folder, e.g. "Book.epub and Book.txt in Documents/Audora". -->
    <string name="copy_done_text">%1$s in %2$s</string>
    <string name="copy_name_separator">" and "</string>
    <!-- %1$d is a number of pages. -->
    <string name="copy_skipped">Pages without readable text: %1$d.</string>
    <string name="copy_failed_title">Copy not saved</string>
    <string name="copy_failed_empty">No page of this PDF has readable text, even with text recognition</string>
    <string name="copy_failed_unreadable">The PDF could not be read from page %1$d</string>
    <string name="copy_failed_storage">Could not save the file: %1$s</string>
    <string name="copy_cancelled_title">Copy cancelled</string>
    <string name="copy_cancelled_text">Nothing was saved</string>
    <!-- File name of a talking book: %1$s the title, e.g. "Moby Dick - talking book". -->
    <string name="copy_talking_book_file">%1$s - talking book</string>
    <!-- Title of a chapter with no heading: %1$d and %2$d are pages. -->
    <string name="copy_pages">Pages %1$d–%2$d</string>
    <!-- Words inside the copy itself. -->
    <string name="copy_contents">Contents</string>
    <string name="copy_page_list">Pages</string>
    <string name="copy_notes">Notes</string>
    <string name="copy_summary_text">Text from the PDF with its headings, lists, tables, notes and printed page numbers. Scanned pages were read with text recognition and may contain recognition errors.</string>
    <string name="copy_summary_audio">Text from the PDF with its headings, lists, tables, notes and printed page numbers, narrated by a synthetic voice with each sentence highlighted as it is read. Scanned pages were read with text recognition and may contain recognition errors.</string>
</resources>
