<?xml version="1.0" encoding="utf-8"?>
<!--
  File: playback/src/main/AndroidManifest.xml
  Purpose: The playback service and the permissions background reading needs (Build Spec §6), merged into the app.
  Never SMS, accessibility or notification-listener permissions (AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Audiobook export (ADR-034): a long user-started render; mediaProcessing on Android 15+, dataSync before. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Voice commands with the screen off (plan item 38), only when the listener turns it on; RECORD_AUDIO is the
         app's own (Settings asks for it). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The playback notification on Android 13+; the UI asks for it on first play. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ExoPlayer's WAKE_MODE_LOCAL keeps the CPU awake while a sentence is synthesized with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A short buzz confirms "shake to extend" on the sleep timer (plan item 37); a normal permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The phone's own text-to-speech engines must be visible to bind them (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".service.AudoraPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!-- A MediaLibraryService (plan item 34): media browsers such as Android Auto list the library and
                 play from it; the legacy browser action is how Android Auto finds media apps. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto shows Audora as a media app (plan item 34); no other car features are used. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Audiobook export (ADR-034): started only from the library's "Save as audiobook" (C7). -->
        <service
            android:name=".export.AudiobookExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Voice commands with the screen off (plan item 38, opt-in): started only from the visible reader.
             Lint reads this manifest alone; RECORD_AUDIO, the type's other permission, is in the app's, so the
             merged manifest has both. -->
        <service
            android:name=".commands.VoiceCommandService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            tools:ignore="ForegroundServicePermission" />

        <!-- Playback resumption (P1-06): a headset's play button after Audora was closed resumes the last book.
             A media button press is a user action (C7); nothing here runs on boot. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
